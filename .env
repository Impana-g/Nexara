# Django
DJANGO_SECRET_KEY=nexara-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — flip to True and fill Supabase details when ready
USE_SUPABASE=False
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=YOUR_PASSWORD
SUPABASE_DB_HOST=db.YOUR_PROJECT.supabase.co
SUPABASE_DB_PORT=5432

# Supabase client SDK
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Redis (your container is already running on 6379)
REDIS_URL=redis://localhost:6379

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Nexara internals
INTERNAL_API_SECRET=nexara-dev-secret
HITL_TIMEOUT_SECONDS=86400